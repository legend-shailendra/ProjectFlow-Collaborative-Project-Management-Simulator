# ==============================================================================
# ProjectFlow Environment Variables
# ==============================================================================

# Backend Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret for Session & Token Authentication
JWT_SECRET=projectflow_super_secret_jwt_key_change_in_production_2026!
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Database Connection URL
# ------------------------------------------------------------------------------
# Default development mode uses SQLite for zero-setup local execution:
DATABASE_URL="file:./dev.db"

# For PostgreSQL setup in production or local Postgres instance:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectflow?schema=public"

# Frontend Vite API URL (Optional, defaults to proxy /api or http://localhost:5000)
VITE_API_URL=http://localhost:5000/api
